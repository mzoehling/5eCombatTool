# Copy to .env.local and fill in.
# Base URL of the upstream JSON data source used by
# `npm run fetch-fixtures` (test fixtures) and `npm run build-srd` (SRD data).
# In CI this is provided as a repository secret.
UPSTREAM_DATA_URL=

# --- Player View (both optional; the built-in defaults need no configuration) ---

# ICE servers for the Player View's WebRTC connection, as a JSON array.
# The defaults in src/features/playerView/iceConfig.ts use free, shared relays
# on a monthly quota — fine for a table, not something to rely on. Set this to
# your own STUN/TURN credentials to stop sharing. Malformed JSON is ignored with
# a console warning rather than breaking a session.
# VITE_ICE_SERVERS=[{"urls":"turns:turn.example.com:443","username":"u","credential":"p"}]

# Signaling broker, as a JSON object of PeerJS options. Empty means the public
# PeerJS cloud, which rate-limits per IP — and every player behind one phone
# hotspot shares an IP, so a table that outgrows it wants its own PeerServer.
# VITE_PEER_SERVER={"host":"peer.example.com","port":443,"path":"/","secure":true}
